{
  "name": "kana-board-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run lint:styles && npm run format && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
